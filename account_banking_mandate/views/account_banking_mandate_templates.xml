<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template
        id="portal_my_home"
        name="Portal My Home : mandates entries"
        inherit_id="portal.portal_my_home"
        priority="40"
        customize_show="True"
    >
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Banking Mandates</t>
                <t t-set="url" t-value="'/my/mandates'" />
                <t t-set="placeholder_count" t-value="'mandate_count'" />
            </t>
        </xpath>
    </template>

    <template
        id="portal_layout"
        name="Portal layout: mandate menu entry"
        inherit_id="portal.portal_breadcrumbs"
        priority="40"
    >
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li
                t-if="page_name == 'mandate' or mandate"
                t-attf-class="breadcrumb-item #{'active ' if not mandate else ''}"
            >
                <a
                    t-if="mandate"
                    t-attf-href="/my/mandates?{{ keep_query() }}"
                >Banking Mandates</a>
                <t t-else="">Banking Mandates</t>
            </li>
            <li t-if="mandate" class="breadcrumb-item active text-truncate">
                <span t-field="mandate.unique_mandate_reference" />
            </li>
        </xpath>
    </template>


    <template id="portal_my_mandates" name="My Banking Mandates">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Banking Mandates</t>
            </t>
            <t t-call="account_banking_mandate.portal_mandate_list" />
        </t>
    </template>

    <template id="portal_mandate_list" name="Banking Mandate List">
        <t t-if="mandates">
            <t t-call="portal.portal_table">
                    <thead>
                        <tr
                        t-attf-class="{{'thead-light' if not groupby == 'none' else ''}}"
                    >
                                <th class="text-left">Mandate Reference</th>
                                <th>Create Date</th>
                                <th>Partner</th>
                                <th>Bank Account</th>
                                <th class="text-left">Company</th>
                                <th>Signature Date</th>
                                <th t-if="groupby == 'state'">
                                    <em
                                class="font-weight-normal text-muted"
                            >Mandates in state:</em>
                                    <span
                                class="text-truncate"
                                t-field="mandate.state"
                            /></th>
                                <th t-if="groupby != 'state'">State</th>
                                <th t-if="groupby == 'company_id'">
                                    <em
                                class="font-weight-normal text-muted"
                            >Mandates in company:</em>
                                    <span
                                class="text-truncate"
                                t-field="mandate.company_id.name"
                            /></th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="mandates" t-as="mandate">
                            <tr>
                                <td>
                                    <a
                                    t-attf-href="/my/mandate/#{mandate.id}?{{ keep_query() }}"
                                >
                                        <span
                                        t-field="mandate.unique_mandate_reference"
                                    />
                                    </a>
                                </td>
                                <td>
                                    <span t-field="mandate.create_date" />
                                </td>
                                <td>
                                    <span t-field="mandate.partner_id" />
                                </td>
                                <td>
                                    <span
                                    t-field="mandate.partner_bank_id.acc_number"
                                />
                                </td>
                                <td class="text-left">
                                    <span t-esc="mandate.company_id.name" />
                                </td>
                                <td>
                                    <span t-field="mandate.signature_date" />
                                </td>
                                <td t-if="groupby != 'state'">
                                    <span
                                    class="badge badge-pill badge-info"
                                    title="Current state of the mandate"
                                    t-esc="mandate.state"
                                />
                                </td>
                            </tr>
                        </t>
                    </tbody>
            </t>
        </t>
    </template>

    <template
        id="portal_account_banking_mandate_page"
        name="Banking Account Portal Template"
    >
        <t t-call="portal.portal_layout">
            <t t-call="portal.portal_record_layout">
                <t t-set="card_header">
                    <div class="row no-gutters">
                        <div class="col-12">
                            <h5 class="d-flex mb-1 mb-md-0 row">
                                <div class="col-9">
                                    <span
                                        t-field="mandate.unique_mandate_reference"
                                        class="text-truncate"
                                    />
                                </div>
                                <div class="col-3 text-right">
                                    <small class="text-right">State:</small>
                                    <span
                                        t-field="mandate.state"
                                        class=" badge badge-pill badge-info"
                                        title="Current state of this baking mandate"
                                    />
                                </div>
                            </h5>
                        </div>
                    </div>
                </t>

                <t t-set="card_body">
                    <div class="row mb-4">
                        <div class="col-12 col-md-6" name="portal_mandate_col_0">
                            <div><strong>Date:</strong> <span
                                    t-field="mandate.create_date"
                                    t-options='{"widget": "datetime"}'
                                /></div>
                            <div><strong>Type:</strong> <span
                                    t-field="mandate.type"
                                /></div>
                            <div><strong>Format:</strong> <span
                                    t-field="mandate.format"
                                /></div>
                                <div><strong>Partner:</strong> <span
                                    t-field="mandate.partner_id"
                                /></div>
                            <div><strong>Bank Account:</strong> <span
                                    t-field="mandate.partner_bank_id.acc_number"
                                /></div>
                            <div><strong>Company:</strong> <span
                                    t-field="mandate.company_id.name"
                                /></div>

                        </div>
                        <div
                            class="col-12 col-md-6 text-right"
                            name="portal_mandates_col_1"
                        >
                        <div t-if="mandate.signature_date"><strong
                                >Signature Date:</strong> <span
                                    t-field="mandate.signature_date"
                                /></div>
                            <div t-if="mandate.last_debit_date"><strong
                                >Last Debit Date:</strong> <span
                                    t-field="mandate.last_debit_date"
                                /></div>
                        </div>
                    </div>
                    <div class="row" t-if="mandate.attachment_ids">
                        <div class="col-12 col-lg-5 col-lg-12">
                            <hr class="mb-1 d-none d-lg-block" />
                            <strong class="d-block mb-2">Attachments</strong>
                            <div class="row">
                                <div class="col-lg-12">
                                    <ul class="list-group">
                                        <a
                                            class="list-group-item list-group-item-action d-flex align-items-center oe_attachments py-1 px-2"
                                            t-foreach='mandate.attachment_ids'
                                            t-as='attachment'
                                            t-attf-href="/web/content/#{attachment.id}?download=true&amp;access_token=#{attachment.access_token}"
                                            target="_blank"
                                            data-no-post-process=""
                                        >
                                            <div
                                                class='oe_attachment_embedded o_image o_image_small mr-2 mr-lg-3'
                                                t-att-title="attachment.name"
                                                t-att-data-mimetype="attachment.mimetype"
                                                t-attf-data-src="/web/image/#{attachment.id}/50x40?access_token=#{attachment.access_token}"
                                            />
                                            <div
                                                class='oe_attachment_name text-truncate'
                                            ><t t-esc='attachment.name' /></div>
                                        </a>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                </t>

            </t>
            <div class="mt32">
                <h4><strong>Message and communication history</strong></h4>
                <t t-call="portal.message_thread">
                    <t t-set="object" t-value="mandate" />
                    <t t-set="pid" t-value="pid" />
                    <t t-set="hash" t-value="hash" />
                </t>
            </div>
        </t>
    </template>


</odoo>
